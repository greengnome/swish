    "onboarding.focus.message" : {
      "comment" : "Description of Swish's background-safe focus and break timers.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accurate focus and break timers keep going when Swish is in the background."
